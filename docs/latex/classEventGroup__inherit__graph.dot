digraph "EventGroup"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="EventGroup",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Composite class representing a festival zone/group containing multiple components."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node2 [label="EventComponent",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventComponent.html",tooltip="Abstract base class representing any structural component in the festival."];
  Node3 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node3 [label="Subject",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSubject.html",tooltip="Abstract Subject base class managing observer registrations and notifications."];
  Node4 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node4 [label="Observer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classObserver.html",tooltip="Abstract Observer interface in the Observer design pattern."];
}
