digraph "Stage"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="Stage",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Concrete Leaf component representing a performance stage."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node2 [label="EventUnit",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventUnit.html",tooltip="Abstract Leaf class in the Composite pattern and Observer in the Observer pattern."];
  Node3 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node3 [label="Observer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classObserver.html",tooltip="Abstract Observer interface in the Observer design pattern."];
  Node4 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node4 [label="EventComponent",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventComponent.html",tooltip="Abstract base class representing any structural component in the festival."];
}
