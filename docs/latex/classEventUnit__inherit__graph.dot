digraph "EventUnit"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="EventUnit",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Abstract Leaf class in the Composite pattern and Observer in the Observer pattern."];
  Node2 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node2 [label="Observer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classObserver.html",tooltip="Abstract Observer interface in the Observer design pattern."];
  Node3 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node3 [label="EventComponent",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventComponent.html",tooltip="Abstract base class representing any structural component in the festival."];
  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node4 [label="Bar",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBar.html",tooltip="Concrete Leaf managing beverage inventory, sales, and last-call protocols."];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node5 [label="EntranceGate",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEntranceGate.html",tooltip="Concrete Leaf managing primary festival entry and age verification."];
  Node1 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node6 [label="FoodVendor",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFoodVendor.html",tooltip="Concrete Leaf managing food inventory and catering operations."];
  Node1 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node7 [label="MedicalTeam",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classMedicalTeam.html",tooltip="Concrete Leaf managing medical triage, supply tracking, and patient admissions."];
  Node1 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node8 [label="SecurityTeam",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSecurityTeam.html",tooltip="Concrete Leaf handling crowd control, personnel deployment, and incident response."];
  Node1 -> Node9 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node9 [label="Stage",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStage.html",tooltip="Concrete Leaf component representing a performance stage."];
  Node1 -> Node10 [dir="back",color="midnightblue",fontsize="10",style="solid"];
  Node10 [label="StageGate",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStageGate.html",tooltip="Concrete Leaf managing localized access control and occupancy tracking for stages."];
}
