digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  rankdir="LR";
  Node0 [label="EventComponent",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventComponent.html",tooltip="Abstract base class representing any structural component in the festival."];
  Node0 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node1 [label="EventGroup",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventGroup.html",tooltip="Composite class representing a festival zone/group containing multiple components."];
  Node0 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node2 [label="EventUnit",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventUnit.html",tooltip="Abstract Leaf class in the Composite pattern and Observer in the Observer pattern."];
  Node2 -> Node3 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node3 [label="Bar",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classBar.html",tooltip="Concrete Leaf managing beverage inventory, sales, and last-call protocols."];
  Node2 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="EntranceGate",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEntranceGate.html",tooltip="Concrete Leaf managing primary festival entry and age verification."];
  Node2 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="FoodVendor",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classFoodVendor.html",tooltip="Concrete Leaf managing food inventory and catering operations."];
  Node2 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node6 [label="MedicalTeam",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classMedicalTeam.html",tooltip="Concrete Leaf managing medical triage, supply tracking, and patient admissions."];
  Node2 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node7 [label="SecurityTeam",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSecurityTeam.html",tooltip="Concrete Leaf handling crowd control, personnel deployment, and incident response."];
  Node2 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node8 [label="Stage",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStage.html",tooltip="Concrete Leaf component representing a performance stage."];
  Node2 -> Node9 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node9 [label="StageGate",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classStageGate.html",tooltip="Concrete Leaf managing localized access control and occupancy tracking for stages."];
  Node12 [label="Observer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classObserver.html",tooltip="Abstract Observer interface in the Observer design pattern."];
  Node12 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node12 -> Node2 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node13 [label="Subject",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classSubject.html",tooltip="Abstract Subject base class managing observer registrations and notifications."];
  Node13 -> Node14 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node14 [label="EventControl",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classEventControl.html",tooltip="Concrete Subject representing top-level event management."];
  Node13 -> Node1 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
}
